# ─── Banco de Dados — Turso (obrigatório em produção) ─────────────────────────
# Crie uma conta gratuita em https://turso.tech
# Depois: turso db create infrequencia && turso db tokens create infrequencia
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=seu-token-aqui

# Em desenvolvimento local, sem essas variáveis, o sistema usa SQLite local (data/app.db)
